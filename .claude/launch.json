{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Next.js Dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "Docker (App + DB + Adminer)",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "up"],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "Adminer (DB UI)",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "up", "adminer", "db"],
      "port": 8080
    }
  ]
}
